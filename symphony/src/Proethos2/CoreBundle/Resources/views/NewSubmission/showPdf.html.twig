<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% trans %}Experiences{% endtrans %}: {{ submission.collectionList|join('|') }}</title>
    <style>

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            font-family: Arial, Helvetica, sans-serif;
            color: #222;
        }

        body {
            margin: 10px 0 0 0 ;
            background: #fff;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: "Roboto", Arial, Helvetica, sans-serif;
        }

        p {
            text-align: justify;
        }

        ul {
            margin: 0;
            padding: 0;
        }

        a {
            overflow-wrap: anywhere;
        }

        hr {
            height: 1px;
            margin: 20px 0;
            border: 0;
            background: #d9d9d9;
        }
        #main-title{
            font-size: 32px;
            margin: 30px auto;
        }
        #main-title small{
            font-size: 20px;
        }
        .content-container {
            width: 90%;
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
        }

        .section-spacing {
            margin-top: 50px;
        }

        #hero {
            display: -webkit-box;
            display: -webkit-flex;
            display: flex;
            -webkit-box-align: end;
            -webkit-align-items: flex-end;
            align-items: flex-end;
            min-height: 430px;
            margin: 20px 0 10px;
            padding: 40px;
            overflow: hidden;
            border-radius: 10px;
            background: -webkit-linear-gradient(
                to top,
                rgba(20, 25, 24, 0.92) 0%,
                rgba(20, 25, 24, 0.60) 32%,
                rgba(20, 25, 24, 0.15) 70%,
                rgba(20, 25, 24, 0.02) 100%
            );
            background: linear-gradient(
                to top,
                rgba(20, 25, 24, 0.92) 0%,
                rgba(20, 25, 24, 0.60) 32%,
                rgba(20, 25, 24, 0.15) 70%,
                rgba(20, 25, 24, 0.02) 100%
            );
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            background-image: url("{{ home_url }}/bundles/proethos2core/img/capa-relato.jpg");
            /*background-image: url("{% for file in submission.attachments if file.uploadType.slug == 'cover' %}{{ absolute_url(asset(file.uri)) }}{% endfor %}");*/
        }

        #hero h1 {
            width: 85%;
            max-width: 900px;
            margin: 0;
            color: #fff;
            font-size: 42px;
            font-weight: 700;
            line-height: 1.15;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
        }

        .update-date {
            float: right;
            font-size: 14px;
        }

        .tag-list li {
            display: inline-block;
            margin: 0 5px 10px 0;
            padding: 2px 20px;
            border-radius: 8px;
            background: #ffcf00;
            color: #333;
            font-size: 12px;
        }

        #experience-summary {
            padding: 10px 20px;
            border: 2px solid #d9d9d9;
            border-radius: 16px;
            background: #ebebeb;
            width: 50%;
            margin-top: 30px;
            display: block;
            font-size: .9rem;
        }

        .clear {
            clear: both;
        }

        .section-title {
            position: relative;
            display: inline-block;
            float: left;          /* Força o H2 a encolher até o tamanho do texto */
            clear: both;          /* Garante que o conteúdo seguinte quebre para a linha de baixo */
            white-space: nowrap;  /* Impede que o texto quebre linha internamente */
            max-width: calc(100% - 18px);
            margin: 30px 0 24px;
            padding: 11px 34px 11px 24px;
            border-radius: 10px 28px 28px 10px;
            background: -webkit-linear-gradient(
                90deg,
                #040284 0%,
                #0a05c9 62%,
                #5554fd 100%
            );
            background: linear-gradient(
                90deg,
                #040284 0%,
                #0a05c9 62%,
                #5554fd 100%
            );
            box-shadow: 0 6px 16px rgba(52, 66, 63, 0.14);
            color: #fff;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.2;
        }

        .section-title::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 12px;
            height: 62%;
            -webkit-transform: translate(-45%, -50%);
            transform: translate(-45%, -50%);
            border-radius: 12px;
            background: #ffcf00;
        }

        .section-title::after {
            content: "";
            position: absolute;
            right: 16px;
            bottom: -5px;
            width: 34px;
            height: 5px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.72);
        }

        .content-image {
            margin: 50px 0;
            text-align: center;
        }

        .content-image img {
            max-width: 100%;
            margin-bottom: 20px;
            border-radius: 16px;
        }

        .image-gallery {
            display: block;
            margin: 50px 0;
            width: 100%;
            letter-spacing: 0;
            word-spacing: 0;
        }

        .image-gallery img {
            display: inline-block; /* Alinha lado a lado */
            vertical-align: top;   /* Alinha todas pelo topo */
            height: 250px;
            border-radius: 12px;
            
            /* Evita quebras de página feias */
            -webkit-page-break-inside: avoid;
            page-break-inside: avoid;
        }

        /* Condição quando existe apenas UMA imagem na galeria */
        .image-gallery img:first-child:last-child {
            width: 100%;
            height: auto;
            margin: 0;
            box-sizing: border-box;
        }

        /* Caso sejam várias imagens lado a lado */
        .image-gallery img:not(:first-child:last-child) {
            width: 31.333%;
            margin-bottom: 16px; /* Adicionado 16px abaixo para o caso de quebrar linha se houver mais de 3 imagens */
            box-sizing: border-box;
        }

        .image-gallery img:not(:first-child):not(:last-child) {
            margin-top: 0;
            margin-right: 2%;
            margin-left: 2%;
        }

        .video-grid {
            display: block;
            margin-left: -12px;
            margin-right: -12px;
        }

        .video-item {
            width: 50%;
            padding: 0 12px;
            margin-bottom: 24px;
            box-sizing: border-box;
        }

        .video-item iframe {
            display: block;
            width: 100%;
            height: 300px;
            border: 0;
            border-radius: 8px;
        }

        .video-item:only-child {
            width: 50%;
            margin-left: 25%;
        }

        .video-flex {
            display: inline-block;
            vertical-align: middle;
        }

        .print-video {
            display: none;
        }

        .file-grid {
            display: -webkit-box;
            display: -webkit-flex;
            display: flex;
            -webkit-flex-wrap: wrap;
            flex-wrap: wrap;
            -webkit-box-align: start;
            -webkit-align-items: flex-start;
            align-items: flex-start;
        }

        .file-item {
            width: 150px;
            margin: 0 24px 24px 0;
            text-align: center;

            /* SOLUÇÃO PARA A SOBREPOSIÇÃO: Força a quebra do texto */
            word-wrap: break-word;       /* Padrão antigo aceito pelo WebKit */
            overflow-wrap: break-word;   /* Padrão moderno */
            word-break: break-all;       /* Força a quebra mesmo no meio de palavras longas/links */
        }

        .file-item a {
            color: #222;
            text-decoration: none;
        }

        .file-icon {
            display: -webkit-box;
            display: -webkit-flex;
            display: flex;
            -webkit-box-align: center;
            -webkit-align-items: center;
            align-items: center;
            -webkit-box-pack: center;
            -webkit-justify-content: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            margin: 0 auto 10px;
            border: 1px solid #f2f2f2;
            border-radius: 8px;
            background: #d9d9d9;
        }

        .file-icon:hover {
            border-color: #d9d9d9;
            background: #f2f2f2;
        }

        .file-icon svg {
            width: 30px;
            height: 30px;
        }

        .file-title {
            display: block;
            font-size: 14px;
            line-height: 1.3;
        }

        .file-url {
            display: none;
        }

        /* Força o link a ter uma área física clicável no motor do WebKit antigo */
        .pdf-link, .video-link {
            display: inline-block !important;
            position: relative !important;
            z-index: 10 !important;
            text-decoration: underline; /* Ajuda o wkhtmltopdf a identificar como link */
            pointer-events: auto !important;
        }

        /* Evita que os spans internos 'engulam' o clique */
        .pdf-link span, .video-link span {
            pointer-events: none !important; 
        }

        .related-links li {
            margin-bottom: 10px;
        }

        .member-badge {
            margin-right: 10px;
            padding: 2px 5px;
            border-radius: 50%;
            background: #ffcf00;
            font-size: 13px;
        }

        #page-footer {
            margin: 50px auto 20px;
            text-align: center;
        }

        #page-footer img {
            height: 50px;
        }
        .clear{
            clear: both;
        }
        #logo-relato{
            height: 100px;
            float: right;
            border: 1px solid #f2f2ff;
            background: #fff;
            padding: 5px;
            border-radius: 12px;
        }

        @media (max-width: 992px) {
            .content-container {
                width: calc(100% - 32px);
            }

            #hero {
                min-height: 360px;
                padding: 28px;
            }

            #hero h1 {
                width: 100%;
            }

            .video-grid {
                grid-template-columns: 1fr;
            }

            .video-item:only-child {
                width: 100%;
            }
            #experience-summary{
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            #hero {
                min-height: 320px;
                padding: 22px;
            }

            #hero h1 {
                font-size: 25px;
                line-height: 1.2;
            }

            .section-title {
                display: block;
                max-width: 100%;
                padding: 10px 20px;
                border-radius: 8px 20px 20px 8px;
                font-size: 24px;
            }

            .section-title::before {
                width: 8px;
            }
        }

        @page {
            size: A4;
            margin: 16mm 15mm 20mm;
        }

        @media print {
            img {
                max-width: 100%;
            }
            html,
            body {
                font-size: 14px;
                -webkit-print-color-adjust: exact;
            }
            body{
                background: none;
            }
            .content-container {
                width: 100%;
                padding: 0 25px;
                max-width: none;
            }

            #hero {
                min-height: auto;
                margin-top: 0;
                padding: 150px 20px 20px;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            #hero h1 {
                width: 100%;
                max-width: none;
                font-size: 24px;
                text-shadow: none;
            }

            .update-date {
                font-size: 12px;
            }

            .tag-list li {
                font-size: 10px;
            }

            .section-title {
                page-break-after: avoid;
                break-after: avoid;
                padding: 8px 18px;
                background: #efefef;
                box-shadow: none;
                color: #222;
                font-size: 22px;
            }

            .section-title::before {
                background: #999;
            }

            .section-title::after {
                display: none;
            }

            p,
            li,
            .content-image,
            .image-gallery,
            .file-item,
            .video-item {
                orphans: 3;
                widows: 3;
            }

            .content-image,
            .image-gallery,
            #experience-summary,
            .file-item,
            .video-item {
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .video-grid,
            .file-grid {
                display: block;
            }

            .video-item {
                width: 100% !important;
                margin-bottom: 12px;
            }

            .video-screen {
                display: none;
            }

            .print-video {
                display: -webkit-box;
                display: -webkit-flex;
                display: flex;
                -webkit-box-align: center;
                -webkit-align-items: center;
                align-items: center;
            }

            .print-video img {
                width: 110px;
                margin-right: 12px;
                height: 62px;
                border: 1px solid #ddd;
                object-fit: cover;
                max-width: 100%;
            }

            .print-video a {
                font-size: 11px;
            }

            .file-item {
                display: -webkit-box;
                display: -webkit-flex;
                display: flex;
                -webkit-box-align: center;
                -webkit-align-items: center;
                align-items: center;
                width: 100%;
                margin-bottom: 8px;
                text-align: left;
            }

            .file-item a {
                display: -webkit-box;
                display: -webkit-flex;
                display: flex;
                -webkit-box-align: center;
                -webkit-align-items: center;
                align-items: center;
            }

            .file-icon {
                width: 28px;
                margin-right: 10px;
                height: 28px;
                margin: 0;
                border: 0;
            }

            .file-icon svg {
                width: 20px;
                height: 20px;
            }

            .file-title {
                font-size: 11px;
            }

            .file-url {
                display: inline;
                margin-left: 8px;
                color: #555;
                font-size: 10px;
            }

            .member-badge {
                font-size: 11px;
            }

            #page-footer {
                display: none;
            }
            #experience-summary{
                width: 60%;
            }
            #logo-relato{
                height: 60px;
            }
            #main-title{
                font-size: 20px;
                margin: 20px auto;
            }
            #main-title small{
                font-size: 14px;
            }
        }
        body{
            background: url("{{ home_url }}/bundles/proethos2core/img/bg-relato.jpg") center top;
            background-size: 100%;
        }
        @media print {
            @page {
                size: A4;
                margin-top: 20px;
            }
        }
    </style>
</head>
<body>
    <div id="main-title" class="content-container">
        <!-- <img src="logo-relato.jpg" id="logo-relato" alt="logo relato"> -->
        <b><small>{% trans %}Experiences{% endtrans %}:</small></b> <br />
        {% for collection in submission.collectionList %}
            <b>{{ collection }}</b> <br />
        {% endfor %}
        <div class="clear"></div>
    </div>
    <section class="content-container">
        <div id="hero">
            <h1>{{ submission.title }}</h1>
        </div>
    </section>

    <section class="container"><section class="content-container ">
        <div class="update-date clear">{% trans %}Updated in{% endtrans %} {{ "now"|date("d/m/Y") }}</div>
        <br />
        <br />
    </section>
    
    <section class="content-container clear">
        <ul class="tag-list">
            {% for descriptor in submission.descriptorsList %}
            <li>{{ descriptor|replace({"\r\n": " ","\n": " ","\r": " "}) }}</li>
            {% endfor %}
        </ul>
        <ul class="tag-list">
            {% for keyword in submission.keywordsList %}
            <li>{{ keyword }}</li>
            {% endfor %}
        </ul>
    </section>

    <section class="content-container">
        <div id="experience-summary">
            {% if submission.context %}
                <h3>{% trans %}Where did it happen?{% endtrans %}</h3>
                <p>{{ submission.context|raw }}</p>
            {% endif %}

            {% if submission.city %}
                <p>{{ submission.city }}{% if submission.region %} - {{ submission.region }}{% endif %}{% if submission.country %}, {{ submission.country.name }}{% endif %}</p>
            {% endif %}

            <h3>{% trans %}Experience Status{% endtrans %}:</h3>
            <p>{{ status[submission.status] }}</p>

            <h3>{% trans %}When was it initiated and implemented?{% endtrans %}</h3>
            <p>{{ submission.startDate|date("d/m/Y") }} - {% if not submission.isCurrentDate %}{{ submission.endDate|date("d/m/Y") }}{% endif %}</p>
        </div>
    </section>

    <section class="content-container">
        {% if submission.introduction %}
        <h2 class="section-title">{% trans %}Presentation/Introduction{% endtrans %}</h2>
        <p class="clear">{{ submission.introduction|raw }}</p>
        {% endif %}

        {% if submission.description %}
        <h2 class="section-title">{% trans %}What is the reason for this experiment?{% endtrans %}</h2>
        <p class="clear">{{ submission.description|raw }}</p>
        {% endif %}

        {% if submission.objectives %}
        <h2 class="section-title">{% trans %}What is the goal of this experiment?{% endtrans %}</h2>
        <p class="clear">{{ submission.objectives|raw }}</p>
        {% endif %}

        {% if submission.resources %}
        <h2 class="section-title">{% trans %}How is this experience taking shape?{% endtrans %}</h2>
        <p class="clear">{{ submission.resources|raw }}</p>
        {% endif %}

        {% if submission.challengesInformation %}
        <h2 class="section-title">{% trans %}What happened along the way?{% endtrans %}</h2>
        <p class="clear">{{ submission.challengesInformation|raw }}</p>
        {% endif %}

        {% if submission.mainResults %}
        <h2 class="section-title">{% trans %}What started to change?{% endtrans %}</h2>
        <p class="clear">{{ submission.mainResults|raw }}</p>
        {% endif %}

        {% if submission.lessonsLearned %}
        <h2 class="section-title">{% trans %}What does this experience teach us?{% endtrans %}</h2>
        <p class="clear">{{ submission.lessonsLearned|raw }}</p>
        {% endif %}

        {% if submission.notes %}
        <h2 class="section-title">{% trans %}Notes{% endtrans %}:</h2>
        <p class="clear">{{ submission.notes|raw }}</p>
        {% endif %}

        <h2 class="section-title">{% trans %}Learn more{% endtrans %}</h2>

        <div class="clear"></div>

        <h2>{% trans %}Images{% endtrans %}</h2>
        <div class="image-gallery">
            {% for file in submission.attachments if file.uploadType.slug == 'image' %}
            <img src="{{ absolute_url(asset(file.uri)) }}" alt="">
            {% endfor %}
        </div>

        <h2>{% trans %}Videos{% endtrans %}</h2>
        <div class="video-grid">
            {% for file in submission.attachments if file.uploadType.slug == 'video' %}
            <div class="video-item video-flex">
                <span class="video-flex">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
                    </svg>
                </span>
                <span class="video-flex"><a href="{{ absolute_url(asset(file.uri)) }}" target="_blank">{{ file.filename }}</a></span>
            </div>
            {% endfor %}
            {% for video in submission.otherVideosLinksList %}
            <div class="video-item">
                <a href="{{ video.url }}" target="_blank" class="video-link"><img src="{{ video.thumb_url }}" alt="thumbnail"></a>
                <span class="video-flex"><a href="{{ video.url }}" target="_blank">{{ video.url }}</a></span>
            </div>
            {% endfor %}
        </div>

        <h2>{% trans %}Files{% endtrans %}</h2>
        <div class="file-grid">
            {% for file in submission.attachments if file.uploadType.slug == 'document' %}
            <div class="file-item">
                <a href="{{ absolute_url(asset(file.uri)) }}" target="_blank" class="pdf-link">
                    <span class="file-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v12"></path>
                            <path d="m7 10 5 5 5-5"></path>
                            <path d="M5 20h14"></path>
                        </svg>
                    </span>
                </a>
                <span class="file-title" style="display: inline-block; vertical-align: middle;">{{ file.filename }}</span>
                <span class="file-url"><a href="{{ absolute_url(asset(file.uri)) }}" target="_blank">{{ file.filename }}</a></span>
            </div>
            {% endfor %}
            {% for file in submission.attachments if file.uploadType.slug == 'others' %}
            <div class="file-item">
                <a href="{{ absolute_url(asset(file.uri)) }}" target="_blank" class="pdf-link">
                    <span class="file-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v12"></path>
                            <path d="m7 10 5 5 5-5"></path>
                            <path d="M5 20h14"></path>
                        </svg>
                    </span>
                </a>
                <span class="file-title" style="display: inline-block; vertical-align: middle;">{{ file.filename }}</span>
                <span class="file-url"><a href="{{ absolute_url(asset(file.uri)) }}" target="_blank">{{ file.filename }}</a></span>
            </div>
            {% endfor %}
        </div>

        <h2>{% trans %}Related Links{% endtrans %}:</h2>
        <ol class="related-links">
            {% for url in submission.relatedLinksList %}
            <li><a href="{{ url }}" target="_blank">{{ url }}</a></li>
            {% endfor %}
        </ol>

        {% if submission.member %}
            <h2 class="section-title">{% trans %}Members{% endtrans %}</h2>
            <div class="clear">
                {% for member in submission.members|sort((a, b) => b.name <=> a.name) %}
                    {{ member.name }} <sup class="member-badge">{{ loop.index }}</sup>
                {% endfor %}
            </div>

            <hr />

            <div>
                {% for member in submission.members|sort((a, b) => b.name <=> a.name) %}
                    {% if member.filiation %}<sup class="member-badge">{{ loop.index }}</sup> {{ member.filiation }} <br /><br />{% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <footer id="page-footer" class="content-container">
        <img src="{{ home_url }}/bundles/proethos2core/img/v_bir_color-{{ app.request.locale }}.png" alt="logo footer">
    </footer>
</body>
</html>