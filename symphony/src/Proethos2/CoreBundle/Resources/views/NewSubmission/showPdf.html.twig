<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% trans %}Experiences{% endtrans %}</title>
    <style>
        *{
            font-family: sans-serif;
        }
        h1, h2, h3, h4, h5, h6{
            font-family: "Roboto", sans-serif;
        }
        ul{
            margin: 0;
            padding: 0;
        }
        a{
            word-wrap: break-word;
        }
        .mt-20{
            margin-top: 20px;
        }
        .mb-20{
            margin-bottom: 20px;
        }
        .color1{
            color: #0027cd;
        }
        .data-update{
            float: right;
            font-size: 14px;
        }
        hr {
            border: 0;
            height: 1px;
            background: #d9d9d9;
            margin: 20px 0;
        }
        .container{
            width: 72%;
            margin: auto;
        }
        .list-tag {
            display: table;
            list-style: none;
            white-space: nowrap;
        }
        .list-tag li{
            background-color: #ffcf00;
            color: #333;
            display: inline-block;
            padding: 5px 20px;
            border-radius: 8px;
            margin: 0 5px 10px 0;
            font-size: 12px;
            float: left;
            white-space: nowrap;
        }
        .cards {
            display: -webkit-box;
            display: -webkit-flex;
            display: flex;
            gap: 20px;
            align-items: stretch; /* Todos com a mesma altura */
            flex-wrap: wrap;
        }
        .card {
            -webkit-box-flex: 1 1 calc(25% - 20px);
            -webkit-flex: 1 1 calc(25% - 20px);
            flex: 1 1 calc(25% - 20px);
            border: 1px solid #d9d9d9;
            border-radius: 8px;
            padding: 10px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            margin-right: 20px;
        }
        .card:last-child {
            margin-right: 0;
        }
        .card h3 {
            margin: 0 0 5px;
            font-size: 18px;
            font-weight: 700;
        }
        .card p {
            margin: 0;
            color: #555;
            line-height: 1.6;
        }
        .card-secton{
            border: 1px solid #d9d9d9;
            border-radius: 8px;
            padding: 10px 20px;
            box-sizing: border-box;
            margin-bottom: 10px;
        }
        .fotos ul{
            display: none;
        }
        .olinks li{
            margin-bottom: 10px;
        }
        #footer{
            text-align: center;
            margin: 20px  auto;
        }
        #footer img{
            height: 50px;
        }
        .m-badge{
            background: #ffcf00;
            border-radius: 50%;
            padding: 2px 5px;
            margin-right: 10px;
            font-size: 13px;
            vertical-align: top;
        }
        .m-list{
            margin: 0;
            padding: 0 10px;
            font-size: 13px;
        }
        .m-list li{
            font-size: 0.8rem;
            margin-bottom: 10px;
        }
        @media (max-width: 992px){
            .container{
                width: 100%;
            }
            .card {
                flex: 1 1 calc(50% - 20px);
            }
        }
        @media print {
            .container{
                width: 100%;
            }
            .card {
                flex: 1 1 calc(50% - 20px);
            }
            .fotos img{
                display: none;
            }
        }
    </style>
</head>
<body>
    <section class="container">
        <b>{% trans %}Experiences{% endtrans %}:</b>
        <div class="data-update">{% trans %}Updated in{% endtrans %} {{ "now"|date("d/m/Y H:i:s") }}</div>
        <h1 class="color1">{{ submission.title }}</h1>
        <ul class="list-tag">
            {% for descriptor in submission.descriptorsList %}
            <li>{{ descriptor|replace({"\r\n": " ","\n": " ","\r": " "}) }}</li>
            {% endfor %}
        </ul>
        <ul class="list-tag">
            {% for keyword in submission.keywordsList %}
            <li>{{ keyword }}</li>
            {% endfor %}
        </ul>
    </section>
    <section class="container">
        <div class="cards mt-20 mb-20">
            <div class="card">
                <h3>{% trans %}Where did it happen?{% endtrans %}</h3>
                {% if submission.context %}
                    <p>{{ submission.context|raw }}</p>
                {% endif %}
                {% if submission.city %}
                    <p>{{ submission.city }}{% if submission.region %} - {{ submission.region }}{% endif %}{% if submission.country %}, {{ submission.country.name }}{% endif %}</p>
                {% endif %}
            </div>

            <div class="card">
                <h3>{% trans %}Who participates?{% endtrans %}</h3>
                {% for resp in submission.responsible|sort((a, b) => b.name <=> a.name) %}
                <p>{{ resp.filiation }}</p>
                {% endfor %}
            </div>

            <div class="card">
                <h3>{% trans %}Experience Status{% endtrans %}:</h3>
                <p>{{ status[submission.status] }}</p>
            </div>

            <div class="card">
                <h3>{% trans %}When was it initiated and implemented?{% endtrans %}</h3>
                <p>{{ submission.startDate|date("d/m/Y") }} - {% if not submission.isCurrentDate %}{{ submission.endDate|date("d/m/Y") }}{% endif %}</p>
            </div>
        </div>
    </section>
    <section class="container card-secton">
        <h2>{% trans %}Members{% endtrans %}</h2>
        {% for member in submission.members|sort((a, b) => b.name <=> a.name) %}
        {{ member.name }} <sup class="m-badge">{{ loop.index }}</sup>
        {% endfor %}
        <hr>
        <div class="m-list">
            {% for member in submission.members|sort((a, b) => b.name <=> a.name) %}
            <sup class="m-badge">{{ loop.index }}</sup> {{ member.filiation }} <br><br>
            {% endfor %}
        </div>
    </section>
    <section class="container card-secton">
        <h2>{% trans %}Presentation/Introduction{% endtrans %}</h2>
        <p>{{ submission.presentation|raw }}</p>
    </section>    
    <section class="container card-secton">
        <h2>{% trans %}What is the reason for this experiment?{% endtrans %}</h2>
        <p>{{ submission.description|raw }}</p>
    </section>    
    <section class="container card-secton">
        <h2>{% trans %}What is the goal of this experiment?{% endtrans %}</h2>
        <p>{{ submission.objectives|raw }}</p>
    </section>    
    <section class="container card-secton">
        <h2>C{% trans %}How is this experience taking shape?{% endtrans %}</h2>
        <p>{{ submission.resources|raw }}</p>
    </section>    
    <section class="container card-secton">
        <h2>{% trans %}What happened along the way?{% endtrans %}</h2>
        <p>{{ submission.challengesInformation|raw }}</p>
    </section>    
    <section class="container card-secton">
        <h2>{% trans %}What started to change?{% endtrans %}</h2>
        <p>{{ submission.mainResults|raw }}</p>
    </section>    
    <section class="container card-secton">
        <h2>{% trans %}What does this experience teach us?{% endtrans %}</h2>
        <p><b>{% trans %}Lessons Learned{% endtrans %}:</b> {{ submission.lessonsLearned|raw }}</p>
    </section>    
    <section class="container card-secton">
        <h2>{% trans %}Learn more{% endtrans %}:</h2>
        <hr>
        <h3>{% trans %}Images{% endtrans %}</h3>
        <ol class="olinks">
            {% for file in submission.attachments if file.uploadType.slug == 'image' %}
            <li><a href="{{ absolute_url(asset(file.uri)) }}" target="_blank">{{ absolute_url(asset(file.uri)) }}</a></li>
            {% endfor %}
        </ol>
    </section>    
    <section class="container card-secton">
        <h3>{% trans %}Videos{% endtrans %}</h3>
        <ol class="olinks">
            {% for file in submission.attachments if file.uploadType.slug == 'video' %}
            <li><a href="{{ absolute_url(asset(file.uri)) }}" target="_blank">{{ absolute_url(asset(file.uri)) }}</a></li>
            {% endfor %}
        </ol>
    </section>    
    <section class="container card-secton">
        <h3>{% trans %}Files{% endtrans %}</h3>
        {% if submission.fullText %}
        <p>{{ submission.fullText }}</p>
        {% endif %}
        <ol class="olinks">
            {% for file in submission.attachments if file.uploadType.slug == 'document' %}
            <li><a href="{{ absolute_url(asset(file.uri)) }}" target="_blank">{{ absolute_url(asset(file.uri)) }}</a></li>
            {% endfor %}
        </ol>
    </section>    
    <section class="container card-secton">
        <h3>{% trans %}Related Links{% endtrans %}:</h3>
        <ol class="olinks">
            {% for url in submission.relatedLinksList %}
            <li><a href="{{ url }}" target="_blank">{{ url }}</a></li>
            {% endfor %}
        </ol>
    </section>
    <section class="container card-secton">
        <h2>{% trans %}Observations{% endtrans %}:</h2>
        <p><b>{% trans %}Abstract{% endtrans %}:</b> {{ submission.notes }}</p>
    </section>

    <footer id="footer" class="container">
        <img src="http://logos.bireme.org/img/pt/v_bir_color.svg" alt="">
    </footer>
</body>
</html>